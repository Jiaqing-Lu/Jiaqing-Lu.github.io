@inproceedings{ddm_appinv_emc2020,
    Title           =       {Approximate Direct Inverse for Embedded Domain Decomposition Method},
    Author          =       {Jiaqing Lu and Jin-Fa Lee},
    booktitle       =       {Proceedings of the IEEE International Symposium on Electromagnetic Compatibility, Signal and Power Integrity},
    address         =       {Reno, NV, USA},
    Pages           =       {45--49},
    Month           =       aug,
    Year            =       {2020},
    award           =       {The embedded domain decomposition method (DDM) is a powerful tool for analyzing complex electromagnetic applications. It can decompose a computational domain into nonconformal subdomains and provide great flexibility in modeling and optimizing add-on components. However, convergence issues are found for embedded DDM, particularly at low frequencies. To overcome the problem, we propose approximate direct inverse (ADI) based on the principle component analysis (PCA) of the system equations. The ADI is utilized as an effective preconditioner ensuring robust convergence of the embedded DDM system.},
    award_name      =       {Best EMC Symposium Paper Award -- Honorable Mention},
    research        =       {ddm,precond,emc},
}

